# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
build
!artifacts/orax-desktop/build/
!artifacts/orax-desktop/build/icon.svg
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/
*.secret

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Playwright (e2e) generated artifacts
test-results/
playwright-report/
.playwright/

# Electron build output (regenerated by `pnpm --filter @workspace/orax-desktop run build`)
artifacts/orax-desktop/out/

# Electron installer output (regenerated by `pnpm --filter @workspace/orax-desktop run package:win`)
artifacts/orax-desktop/release/
