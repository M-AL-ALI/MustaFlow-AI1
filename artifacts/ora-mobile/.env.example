# ─────────────────────────────────────────────────────────────────────────────
# Ora Mobile — environment variables
# Copy this file to .env and fill in values for local development.
# For EAS builds, set these as EAS secrets or in eas.json build.*.env.
# ─────────────────────────────────────────────────────────────────────────────

# The production API domain (no https:// prefix, no trailing slash).
# In dev this is injected automatically from $REPLIT_DEV_DOMAIN by the dev script.
# For EAS production builds, set this to your deployed API domain, e.g.:
#   www.mustaflow.com
#   yourapp.replit.app
# NOTE: use the host that actually resolves over public DNS. The apex
# `mustaflow.com` has no A record; only `www.mustaflow.com` is live, so the
# apex would surface on-device as "Network request failed".
EXPO_PUBLIC_DOMAIN=

# Ora streaming is ON by default (matches website behaviour).
# Set to "false" as an explicit kill switch to force non-streaming /chat fallback.
# Omit this variable (or set it to anything other than "false") to keep streaming on.
EXPO_PUBLIC_ORA_STREAMING_ENABLED=

# Clerk publishable key for authentication.
# Dev: injected from $CLERK_PUBLISHABLE_KEY (pk_test, the dev Clerk instance) by
# the dev script. Leave blank here.
# EAS production builds: these are NOT auto-swapped to live keys (EAS runs outside
# Replit's publish pipeline), so the LIVE key (pk_live_..., the prod Clerk
# instance) is pinned in eas.json under build.testflight.env / build.production.env.
# Shipping the dev pk_test in a prod build makes the deployed server reject every
# token with 401 (instance/issuer mismatch), even though sign-in appears to work.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk proxy URL.
# Dev: injected from $CLERK_PROXY_URL by the dev script (usually empty; dev talks
# to the dev Clerk FAPI directly). Leave blank here.
# EAS production builds: MUST be set so the app reaches the LIVE Clerk instance the
# same way the website does (https://www.mustaflow.com/api/__clerk). Pinned in
# eas.json. Do NOT leave this empty for prod builds.
EXPO_PUBLIC_CLERK_PROXY_URL=
