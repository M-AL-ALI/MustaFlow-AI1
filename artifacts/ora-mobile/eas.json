{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_ORA_STREAMING_ENABLED": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_ORA_STREAMING_ENABLED": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ORA_STREAMING_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
