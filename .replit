modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

# Builder workspace documents must be cross-origin isolated so browser
# WebContainers can use SharedArrayBuffer. Keep these rules scoped away from
# /api so published user snapshots retain their existing embedding behavior.
[[deployment.responseHeaders]]
path = "/projects"
name = "Cross-Origin-Opener-Policy"
value = "same-origin"

[[deployment.responseHeaders]]
path = "/projects"
name = "Cross-Origin-Embedder-Policy"
value = "credentialless"

[[deployment.responseHeaders]]
path = "/projects/*"
name = "Cross-Origin-Opener-Policy"
value = "same-origin"

[[deployment.responseHeaders]]
path = "/projects/*"
name = "Cross-Origin-Embedder-Policy"
value = "credentialless"

[[deployment.responseHeaders]]
path = "/assets/*"
name = "Cross-Origin-Opener-Policy"
value = "same-origin"

[[deployment.responseHeaders]]
path = "/assets/*"
name = "Cross-Origin-Embedder-Policy"
value = "credentialless"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mustaflow run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/ora-mobile run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"

[[workflows.workflow]]
name = "push-to-github"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/push-to-github.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "ora-gate-fast"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run ora:stability-gate"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "codegen-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-spec run codegen && git diff --exit-code lib/api-client-react/src/generated lib/api-zod/src/generated"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "pull-from-github"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/pull-from-github.sh"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[userenv]

[userenv.shared]
FLY_APP_NAME = "mustaflow-containers"
FLY_REGION = "iad"
