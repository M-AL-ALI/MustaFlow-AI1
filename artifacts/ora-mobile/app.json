{
  "expo": {
    "name": "MustaFlow",
    "slug": "mustaflow-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ora-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mustaflow.app",
      "buildNumber": "1",
      "deploymentTarget": "16.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mustaflow.app",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://mustaflow.com"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow MustaFlow to use your microphone so you can talk to Ora by voice."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow MustaFlow to access your camera to capture photos.",
          "microphonePermission": false,
          "photosPermission": "Allow MustaFlow to access your photo library to share images."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow MustaFlow to save generated images to your photo library.",
          "savePhotosPermission": "Allow MustaFlow to save generated images to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "3d5b04c7-5c08-4e5f-b660-b172c416ddb8"
      }
    },
    "owner": "mus192"
  }
}
