# ─────────────────────────────────────────────────────────────────────────────
# Ora Mobile — environment variables
# Copy this file to .env and fill in values for local development.
# For EAS builds, set these as EAS secrets or in eas.json build.*.env.
# ─────────────────────────────────────────────────────────────────────────────

# The production API domain (no https:// prefix, no trailing slash).
# In dev this is injected automatically from $REPLIT_DEV_DOMAIN by the dev script.
# For EAS production builds, set this to your deployed API domain, e.g.:
#   mustaflow.com
#   yourapp.replit.app
EXPO_PUBLIC_DOMAIN=

# Enable SSE streaming for Ora chat responses.
# Set to "true" in all build profiles (already set in eas.json).
EXPO_PUBLIC_ORA_STREAMING_ENABLED=true

# Clerk publishable key for authentication.
# Dev key is injected from $CLERK_PUBLISHABLE_KEY by the dev script.
# For EAS builds, use your Clerk production publishable key (pk_live_...).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional: Clerk proxy URL (used in Replit dev environment only).
# Leave empty for EAS / production builds.
EXPO_PUBLIC_CLERK_PROXY_URL=
