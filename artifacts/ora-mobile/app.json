{
  "expo": {
    "name": "Ora by MustaFlow",
    "slug": "ora-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ora-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mustaflow.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mustaflow.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://mustaflow.com"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Ora to use your microphone so you can talk to Ora by voice."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Ora to access your camera to capture photos.",
          "microphonePermission": false,
          "photosPermission": "Allow Ora to access your photo library to share images."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Ora to save generated images to your photo library.",
          "savePhotosPermission": "Allow Ora to save generated images to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
